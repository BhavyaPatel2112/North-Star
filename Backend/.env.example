# Copy this file to .env (same folder) and fill in the real values.
# .env is ignored by Git, so your secrets never reach GitHub.

# Supabase PostgreSQL connection string.
# Supabase dashboard > Connect > "Session pooler" (works on home networks without IPv6).
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# OpenAQ API key, for live and historical station readings.
# Free account at https://explore.openaq.org > Account > API Key.
OPENAQ_API_KEY=

# Government of India open data portal (data.gov.in), for live station readings.
# Sign in at https://www.data.gov.in > My Account > generate API key.
DATAGOVIN_API_KEY=

# World Air Quality Index project, for live readings (fallback source).
# Request at https://aqicn.org/data-platform/token/ (token arrives by email).
WAQI_TOKEN=

# NASA FIRMS fire detections from satellites.
# Free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Google Air Quality API (Google Maps Platform), for comparison and possibly live readings.
# Google Cloud console > APIs & Services > Credentials. Restrict it to the Air Quality API.
GOOGLE_AIR_QUALITY_KEY=

# Supabase PUBLISHABLE key (sb_publishable_...), built into the iOS app.
# Supabase dashboard > Project Settings > API Keys. Never use a secret key here.
# After setting it, run: .venv/bin/python -m scripts.write_app_config
SUPABASE_PUBLISHABLE_KEY=
